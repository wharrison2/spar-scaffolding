+#!/usr/bin/env bash
+# Runs ON the pod. Replaces the running overnight chain orchestrator by a new one that uses staged code and the newest run_configuration_overnight_chain_*.json,
+# without deleting the pod (SIGTERM would: the orchestrator's every ending deletes the pod). The chain resumes from its completion markers.
+#
+#   bash <this file> --working-directory <W on the volume> --seconds-until-hard-limit <n> --pod-hourly-price-dollars <price> [--dry-run]
+#
+# Expects the code staged in <W>/staged_code_for_chain_extension (the same layout as <W>: scripts/..., run_folder/run_configuration_*.json).
+# Steps: (1) check that exactly one orchestrator runs; (2) start a decoy process whose command line matches the orchestrator pattern, so that the pod's
+# dead-man watchdog and the launcher's "scorer vanished" check never see a gap; (3) SIGKILL the orchestrator (it cannot run its ending), then stop the
+# running step's process group and wait until the GPU is free; (4) sync the container work tree to the volume (a restart restores the work tree from the
+# volume, and a volume copy older than the container's would overwrite it); (5) copy the staged code over <W>; (6) start the new orchestrator exactly as the
+# launcher does; (7) remove the decoy once the new orchestrator runs.
+set -u
+WORKING_DIRECTORY=""; SECONDS_UNTIL_HARD_LIMIT=""; HOURLY_PRICE=""; DRY_RUN=0
+CONTAINER_WORK_ROOT="/root/overnight_work"
+ORCHESTRATOR_COMMAND_PATTERN='^python3 scripts/emergent_misalignment/overnight_chain/run_overnight_treatment_arm_chain_on_pod.py'
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --working-directory) WORKING_DIRECTORY="$2"; shift 2;;
+    --seconds-until-hard-limit) SECONDS_UNTIL_HARD_LIMIT="$2"; shift 2;;
+    --pod-hourly-price-dollars) HOURLY_PRICE="$2"; shift 2;;
+    --container-work-root) CONTAINER_WORK_ROOT="$2"; shift 2;;
+    --dry-run) DRY_RUN=1; shift;;
+    *) echo "unknown argument $1"; exit 2;;
+  esac
+done
+[ -n "$WORKING_DIRECTORY" ] && [ -n "$SECONDS_UNTIL_HARD_LIMIT" ] || { echo "need --working-directory and --seconds-until-hard-limit"; exit 2; }
+STAGED="$WORKING_DIRECTORY/staged_code_for_chain_extension"
+RUN_FOLDER="$WORKING_DIRECTORY/run_folder"
+say() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }
+act() { if [ "$DRY_RUN" = 1 ]; then say "dry run, would: $*"; else "$@"; fi; }
+
+ORCHESTRATORS=$(pgrep -f "$ORCHESTRATOR_COMMAND_PATTERN" || true)
+[ "$(echo "$ORCHESTRATORS" | grep -c .)" = 1 ] || { say "expected exactly one orchestrator process, found: '$ORCHESTRATORS'. Nothing was touched."; exit 1; }
+ORCHESTRATOR="$ORCHESTRATORS"
+STEP_LEADER=$(pgrep -P "$ORCHESTRATOR" | head -n 1 || true)
+[ -d "$STAGED/scripts" ] || { say "no staged code in $STAGED. Nothing was touched."; exit 1; }
+ls "$STAGED"/run_folder/run_configuration_overnight_chain_*.json > /dev/null 2>&1 || { say "no staged configuration. Nothing was touched."; exit 1; }
+say "orchestrator $ORCHESTRATOR, running step process group leader '${STEP_LEADER:-none: between steps}'"
+say "chain status: $(tr -d '\n ' < "$RUN_FOLDER/overnight_outputs/chain_summary_and_progress/chain_status.json" 2>/dev/null | cut -c1-200)"
+
+say "starting the decoy (matches the orchestrator pattern for 20 minutes at most)"
+if [ "$DRY_RUN" = 1 ]; then DECOY=0; else
+  nohup bash -c 'sleep 1200; : run_overnight_treatment_arm_chain_on_pod decoy' > /dev/null 2>&1 &
+  DECOY=$!
+fi
+
+say "killing the orchestrator (SIGKILL) and stopping the step"
+act kill -KILL "$ORCHESTRATOR"
+if [ -n "$STEP_LEADER" ]; then
+  act kill -TERM -- "-$STEP_LEADER"
+  if [ "$DRY_RUN" = 0 ]; then
+    for _ in $(seq 1 40); do kill -0 -- "-$STEP_LEADER" 2>/dev/null || break; sleep 1; done
+    kill -0 -- "-$STEP_LEADER" 2>/dev/null && { say "step still alive after 40 s: SIGKILL"; kill -KILL -- "-$STEP_LEADER"; }
+  fi
+fi
+if [ "$DRY_RUN" = 0 ] && command -v nvidia-smi > /dev/null 2>&1; then
+  for _ in $(seq 1 90); do [ "$(nvidia-smi --query-compute-apps=pid --format=csv,noheader | grep -c .)" = 0 ] && break; sleep 1; done
+  say "GPU processes left: $(nvidia-smi --query-compute-apps=pid --format=csv,noheader | grep -c .)"
+fi
+
+say "syncing the container work tree to the volume"
+if [ "$DRY_RUN" = 0 ]; then
+  (cd "$WORKING_DIRECTORY" && PYTHONPATH="$WORKING_DIRECTORY" python3 - "$CONTAINER_WORK_ROOT/overnight_outputs" "$RUN_FOLDER/overnight_outputs" <<'PY'
+import sys
+from scripts.emergent_misalignment.overnight_chain import overnight_treatment_arm_chain_step_definitions as definitions
+from scripts.shared import sync_work_tree_to_durable_volume_with_size_verification as sync
+result = sync.sync_tree(sys.argv[1], sys.argv[2], definitions.SYNC_EXCLUDE_PATTERNS)
+print("sync:", {key: result[key] for key in ("files_copied", "files_unchanged", "bytes_copied")}, "problems:", result["problems"][:3])
+sys.exit(1 if result["problems"] else 0)
+PY
+  ) || { say "SYNC HAD PROBLEMS: the new orchestrator is NOT started. The decoy keeps the pod safe for 20 minutes; fix it or start the orchestrator by hand."; exit 1; }
+fi
+
+say "copying the staged code and configuration over $WORKING_DIRECTORY"
+act cp -a "$STAGED/." "$WORKING_DIRECTORY/"
+
+say "starting the new orchestrator"
+INNER="cd $WORKING_DIRECTORY && . $WORKING_DIRECTORY/pod_secret_environment.sh && python3 scripts/emergent_misalignment/overnight_chain/run_overnight_treatment_arm_chain_on_pod.py --working-directory $WORKING_DIRECTORY --seconds-until-hard-limit $SECONDS_UNTIL_HARD_LIMIT${HOURLY_PRICE:+ --pod-hourly-price-dollars $HOURLY_PRICE} > $RUN_FOLDER/scorer_standard_output.txt 2>&1; echo \$? > $RUN_FOLDER/scorer_exit_code.txt"
+if [ "$DRY_RUN" = 1 ]; then say "dry run, would run: nohup bash -c '$INNER'"; exit 0; fi
+nohup bash -c "$INNER" > /dev/null 2>&1 &
+for _ in $(seq 1 30); do pgrep -f "$ORCHESTRATOR_COMMAND_PATTERN" > /dev/null && break; sleep 1; done
+pgrep -f "$ORCHESTRATOR_COMMAND_PATTERN" > /dev/null || { say "THE NEW ORCHESTRATOR IS NOT RUNNING. The decoy is kept for its 20 minutes; read $RUN_FOLDER/scorer_standard_output.txt"; exit 1; }
+sleep 20
+pgrep -f "$ORCHESTRATOR_COMMAND_PATTERN" > /dev/null || { say "THE NEW ORCHESTRATOR EXITED. The decoy is kept; read $RUN_FOLDER/scorer_standard_output.txt"; exit 1; }
+kill -KILL "$DECOY" 2>/dev/null
+say "new orchestrator running as $(pgrep -f "$ORCHESTRATOR_COMMAND_PATTERN"); decoy removed"
+tail -n 5 "$RUN_FOLDER/scorer_standard_output.txt"
