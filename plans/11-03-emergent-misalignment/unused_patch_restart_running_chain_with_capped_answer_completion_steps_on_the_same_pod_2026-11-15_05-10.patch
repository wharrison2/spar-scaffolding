+def extend_chain_in_place(chain_run_folder, timestamp=None):
+    """Writes a new run_configuration_overnight_chain_<timestamp>.json into the chain's own run folder: the chain's configuration plus
+    APPENDED_COMPLETION_KEY, so that a chain restarted with it runs the completion pass after its last step. The earlier configuration file stays."""
+    chain_run_folder = Path(chain_run_folder)
+    timestamp = timestamp or datetime.now().strftime("%Y-%m-%d_%H-%M")
+    configurations = sorted(chain_run_folder.glob("run_configuration_overnight_chain_*.json"))
+    if not configurations or configurations[-1].name >= f"run_configuration_overnight_chain_{timestamp}.json":
+        raise SystemExit("no configuration to extend, or the new one would not sort after the latest")
+    configuration = json.loads(configurations[-1].read_text(encoding="utf-8"))
+    configuration[APPENDED_COMPLETION_KEY] = {"built_at": datetime.now().isoformat(timespec="seconds")}
+    path = chain_run_folder / f"run_configuration_overnight_chain_{timestamp}.json"
+    path.write_text(json.dumps(configuration, indent=2), encoding="utf-8")
+    print(f"Wrote {path}")
+    return path
+
